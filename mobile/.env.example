# Por padrao aponta pro servidor de teste no Render (publico, funciona de
# qualquer rede, mesmo banco BASE_TESTE usado em dev local).
EXPO_PUBLIC_API_BASE_URL=https://apontamento-v2-testes.onrender.com

# Alternativa pra desenvolvimento contra o servidor local (`python manage.py
# runserver 0.0.0.0:8000`): troque pelo IP de LAN do PC. Lembre que builds
# standalone (.apk via EAS) fixam essa URL no momento do build - pra testar
# local, use o Expo Go (npx expo start), que le o .env a cada reload.
# EXPO_PUBLIC_API_BASE_URL=http://192.168.x.x:8000
